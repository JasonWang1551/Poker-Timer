<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/edit_menu"
    android:layout_width="760dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@color/menu_background"
    android:orientation="horizontal"
    android:padding="24dp"
    android:visibility="gone">

    <ScrollView
        android:id="@+id/level_list_scroll"
        android:layout_width="260dp"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/level_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:background="@color/selection_overlay" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/editor_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:textColor="@color/timer_status"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Level 1" />

            <TextView
                android:id="@+id/editor_title_label"
                style="@style/EditorLabel"
                android:text="@string/optional_title" />

            <EditText
                android:id="@+id/editor_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:id="@+id/small_blind_row"
                style="@style/EditorRow">

                <TextView
                    style="@style/EditorLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/small_blind" />

                <EditText
                    android:id="@+id/editor_small_blind"
                    style="@style/EditorNumber" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/double_big_blind_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/double_big_blind"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/indefinite_break_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/indefinite_break"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/big_blind_row"
                style="@style/EditorRow">

                <TextView
                    style="@style/EditorLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/big_blind" />

                <EditText
                    android:id="@+id/editor_big_blind"
                    style="@style/EditorNumber" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/has_ante_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/has_ante"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/ante_equals_big_blind_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ante_equals_big_blind"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ante_row"
                style="@style/EditorRow"
                android:visibility="gone">

                <TextView
                    style="@style/EditorLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/ante_amount" />

                <EditText
                    android:id="@+id/editor_ante"
                    style="@style/EditorNumber" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/set_level_time_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/set_level_time"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/time_row"
                style="@style/EditorRow">
                <TextView
                    style="@style/EditorLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/time_minutes" />

                <EditText
                    android:id="@+id/editor_minutes"
                    style="@style/EditorNumber" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/move_item_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/move_item_up_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/move_up" />

                <Button
                    android:id="@+id/move_item_down_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/move_down" />
            </LinearLayout>

            <Button
                android:id="@+id/remove_item_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/remove_level" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
